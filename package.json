{
  "name": "plex-community-service",
  "version": "2.0.0",
  "description": "web interface for mega-cmd and plex discord notifier all-in-one",
  "main": "index.js",
  "scripts": {
    "help": "node ./util/scripts/help.js",
    "ui:dev": "vite",
    "ui:build": "vite build",
    "ui:preview": "vite preview",
    "adapters": "node ./util/scripts/list-adapters.js",
    "bot:deploy": "node ./discord_bot/deploy-commands.js",
    "test:plex": "node ./test/test_plex.js",
    "prod:init": "vite build && pm2 start index.js --name app && pm2 save",
    "prod:resurrect": "pm2 resurrect",
    "prod:stop": "pm2 stop app",
    "prod:restart": "pm2 restart app",
    "prod:logs": "pm2 logs app",
    "shad:add": "npx shadcn@latest add"
  },
  "type": "module",
  "keywords": [],
  "author": "gort",
  "license": "ISC",
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-react": "^4.6.0",
    "axios": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "cron": "^4.3.0",
    "discord.js": "^14.20.0",
    "express": "^5.1.0",
    "form-data": "^4.0.2",
    "lucide-react": "^0.525.0",
    "multer": "^1.4.5-lts.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "systeminformation": "^5.25.11",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.3.5",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "pm2": "^6.0.8",
    "vite": "^7.0.2"
  }
}
